# harness.folk — run folkville on REAL Folk with no camera, projector or
# printer. The Folk half of the virtual table (see dev-table/README.md).
#
# Everything that makes folkville folkville runs for real here: the statement
# database, the pattern matcher, When/Hold!/Query!, program bodies. Only the
# hardware is stood in for:
#
#   projector -> a virtual `display "web"` claim
#   camera    -> mouse drags become quad claims (bridge.folk)
#   renderer  -> draw wishes are serialized to JSON for a canvas (bridge.folk)
#
# Run from a built Folk checkout:  ./folk /path/to/dev-table/harness.folk

set ::DEVTABLE [file dirname [file normalize [info script]]]
set ::FVDIR [file join [file dirname $::DEVTABLE] folkville]
if {[info exists ::env(FOLKVILLE_DIR)]} { set ::FVDIR $::env(FOLKVILLE_DIR) }

# ---- the program-loading mechanism, lifted from boot.folk ----------------
Assert! when /_this/ has program code /programCode/ {
    SayWithSource $_this 1 0 {} {} \
        when $programCode with environment [list [list this $_this]]
} with environment {}

proc LoadProgram! {path} {
    set fp [open $path r]; set code [read $fp]; close $fp
    Hold! -key [list $path code] Claim $path has program code $code
}

# ---- stand-ins for the hardware ------------------------------------------
Assert! display "web" has width 1200 height 760
# bridge.folk's When bodies run in their own interpreter, so they can't read
# this script's variables — hand them the path as a claim instead.
Assert! the folkville directory is $::FVDIR

# ---- the real folkville programs, unmodified, plus the browser bridge ----
foreach f {folkville.folk folkville-bulldozer.folk folkville-paver.folk
           folkville-crane.folk folkville-reset.folk} {
    LoadProgram! [file join $::FVDIR $f]
}
LoadProgram! [file join $::DEVTABLE bridge.folk]
puts $::realStderr "harness: folkville loaded from $::FVDIR"
puts $::realStderr "harness: now run dev-table/server.py and open http://localhost:4274"

# The main thread must stay out of the way. Running the bridge's poll loop
# here instead wedges the evaluator: folkville's engine loop stops after a
# handful of ticks and the world freezes.
while true { sleep 5 }
